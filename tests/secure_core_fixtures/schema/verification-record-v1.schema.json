{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.weftocct.example/v1/verification-record-v1.schema.json",
  "title": "CAD mesher consumer verification record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "fixture_id",
    "obligation_id",
    "claim_ids",
    "expectation_sha256",
    "review_record_sha256",
    "fixture_input_kind",
    "fixture_input_sha256",
    "consumer_id",
    "consumer_contract_sha256",
    "consumer_milestone",
    "consumer_commit",
    "test_path",
    "test_sha256",
    "result_path",
    "result_sha256",
    "outcome",
    "verified_on"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "canonicalization": { "const": "sorted-pretty-json-v1" },
    "fixture_id": { "$ref": "#/$defs/stable_code" },
    "obligation_id": {
      "type": "string",
      "pattern": "^(TOP|CRV|SRF|SEM|TRM|PAT|SUP|REC|SRC)-[0-9]{3}$"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stable_code" },
      "uniqueItems": true,
      "x-canonical-order": "ascending claim id"
    },
    "expectation_sha256": { "$ref": "#/$defs/sha256" },
    "review_record_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_input_kind": { "enum": ["step_artifact", "native_source_contract"] },
    "fixture_input_sha256": { "$ref": "#/$defs/sha256" },
    "consumer_id": { "$ref": "#/$defs/stable_code" },
    "consumer_contract_sha256": { "$ref": "#/$defs/sha256" },
    "consumer_milestone": { "type": "string", "pattern": "^M(?:[2-9]|1[0-2])$" },
    "consumer_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "test_path": {
      "type": "string",
      "pattern": "^tests/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:cpp|py)$"
    },
    "test_sha256": { "$ref": "#/$defs/sha256" },
    "result_path": {
      "type": "string",
      "pattern": "^fixtures/verifications/results/[a-z0-9_.-]+\\.json$"
    },
    "result_sha256": { "$ref": "#/$defs/sha256" },
    "outcome": { "const": "passed" },
    "verified_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "$defs": {
    "stable_code": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
