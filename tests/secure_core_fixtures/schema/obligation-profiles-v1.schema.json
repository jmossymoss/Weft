  "$defs": {
    "stable_code": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "family_id": {
      "enum": [
        "family.assembly_instances",
        "family.curve_taxonomy",
        "family.edge_representation",
        "family.external_corpus",
        "family.import_failures",
        "family.native_faults",
        "family.numeric_pathology",
        "family.reconnaissance_consumers",
        "family.semantic_blends",
        "family.semantic_primitives",
        "family.support_decisions",
        "family.surface_freeform_wrappers",
        "family.surface_periodic_singular",
        "family.topology_hierarchy",
        "family.trim_faults",
        "family.trim_valid_domains"
      ]
    },
    "evidence_lane": {
      "enum": [
        "audited_external",
        "derived_corruption",
        "native_fault_injection",
        "occt_procedural"
      ]
    },
    "evidence_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "lanes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "all_of",
            "any_of",
            "single"
          ]
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_lane"
          },
          "uniqueItems": true,
          "x-canonical-order": "ascending evidence lane"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "single"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "lanes": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "all_of",
                  "any_of"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "lanes": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "observation_kind": {
      "enum": [
        "continuity",
        "curve_geometry",
        "curve_representation",
        "evaluator_result",
        "external_provenance",
        "gate_result",
        "locations",
        "numerical_measurement",
        "orientation",
        "ownership_licence",
        "pcurve_mapping",
        "periodicity",
        "recognition_evidence",
        "report_determinism",
        "semantic_candidate",
        "singularity",
        "source_provenance",
        "source_transform",
        "step_import",
        "support_assignment",
        "surface_geometry",
        "surface_representation",
        "topology_counts",
        "topology_identity",
        "topology_incidence",
        "topology_occurrences",
        "trim_domain",
        "validation_finding",
        "vertex_parameters",
        "viewer_state"
      ]
    },
    "predicate_family": {
      "enum": [
        "curve.analytic",
        "curve.parameter_consistency",
        "curve.spline",
        "curve.topological_representation",
        "curve.wrapper",
        "pathology.evaluator",
        "pathology.numeric",
        "pathology.topology",
        "reconnaissance.corpus",
        "reconnaissance.fail_closed",
        "reconnaissance.import",
        "reconnaissance.inventory",
        "reconnaissance.report",
        "reconnaissance.viewer",
        "semantic.blend",
        "semantic.confidence",
        "semantic.feature",
        "semantic.freeform",
        "semantic.primitive",
        "source.external",
        "support.gate",
        "support.state",
        "support.totality",
        "surface.analytic",
        "surface.continuity_metric",
        "surface.periodic_singularity",
        "surface.spline",
        "surface.wrapper",
        "topology.edge",
        "topology.entity",
        "topology.import_failure",
        "topology.model",
        "topology.orientation",
        "topology.transform",
        "trim.invalid_domain",
        "trim.valid_domain"
      ]
    },
    "milestone": {
      "type": "string",
      "pattern": "^M(?:[0-9]|1[0-2])$"
    },
    "corpus_constraint": {
      "enum": [
        "all_applicable_fixtures",
        "complete_external_corpus",
        "complete_synthetic_corpus",
        "consumer_verification_required",
        "cross_lane_corpus",
        "derived_runner_registered",
        "exact_evaluator_boundary",
        "exact_subject_identity",
        "external_authorship_verified",
        "file_verified_step_schema",
        "independent_exporter_matrix",
        "independent_oracle",
        "native_runner_registered",
        "no_meshing_fallback",
        "nonrigid_source_transform_contract",
        "pcurve_repair_disabled",
        "plasticity_family_matrix",
        "post_step_processing_disabled",
        "qt6_viewer_required",
        "redistribution_authority",
        "source_bound_mutation",
        "unknown_type_injection",
        "wrapper_survives_roundtrip_or_external"
      ]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_prerequisite_families",
        "consumer_milestones",
        "corpus_constraints"
      ],
      "properties": {
        "fixture_prerequisite_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family_id"
          },
          "uniqueItems": true,
          "x-canonical-order": "ascending family id"
        },
        "consumer_milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/milestone"
          },
          "uniqueItems": true,
          "x-canonical-order": "ascending milestone number"
        },
        "corpus_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/corpus_constraint"
          },
          "uniqueItems": true,
          "x-canonical-order": "ascending constraint"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_order",
        "title",
        "proposed_fixture_ids",
        "shared_construction_foundation",
        "prerequisite_families",
        "delivery_constraints"
      ],
      "properties": {
        "batch_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "proposed_fixture_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stable_code"
          },
          "uniqueItems": true,
          "x-canonical-order": "ascending fixture id"
        },
        "shared_construction_foundation": {
          "type": "string",
          "minLength": 1
        },
        "prerequisite_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family_id"
          },
          "uniqueItems": true,
          "x-canonical-order": "ascending family id"
        },
        "delivery_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/corpus_constraint"
          },
          "uniqueItems": true,
          "x-canonical-order": "ascending constraint"
        }
      }
    },
    "obligation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "evidence_requirement",
        "observation_kinds",
        "predicate_family",
        "dependencies"
      ],
      "properties": {
        "family_id": {
          "$ref": "#/$defs/family_id"
        },
        "evidence_requirement": {
          "$ref": "#/$defs/evidence_requirement"
        },
        "observation_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation_kind"
          },
          "uniqueItems": true,
          "x-canonical-order": "ascending observation kind"
        },
        "predicate_family": {
          "$ref": "#/$defs/predicate_family"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencies"
        }
      }
    }
  }
}
