{
  "$defs": {
    "assignment": {
      "additionalProperties": false,
      "properties": {
        "claim_boundary": {
          "maxLength": 800,
          "minLength": 16,
          "type": "string"
        },
        "fixture_id": {
          "$ref": "#/$defs/stable_id"
        },
        "independent_oracle_intent": {
          "maxLength": 1200,
          "minLength": 20,
          "type": "string"
        },
        "intended_import_outcome": {
          "$ref": "#/$defs/import_outcome"
        },
        "intended_support_gate_outcome": {
          "$ref": "#/$defs/support_gate_outcome"
        },
        "lane": {
          "enum": [
            "audited_external",
            "derived_corruption",
            "legacy_occt_procedural",
            "m1_consumer_oracle",
            "native_fault_injection",
            "occt_procedural"
          ]
        },
        "materialization_status": {
          "enum": [
            "feasible",
            "ready"
          ]
        },
        "readiness": {
          "enum": [
            "legacy_already_ready",
            "requires_materialization"
          ]
        },
        "source_or_baseline_id": {
          "$ref": "#/$defs/stable_id"
        }
      },
      "required": [
        "claim_boundary",
        "fixture_id",
        "independent_oracle_intent",
        "intended_import_outcome",
        "intended_support_gate_outcome",
        "lane",
        "materialization_status",
        "readiness",
        "source_or_baseline_id"
      ],
      "type": "object"
    },
    "import_outcome": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 500,
          "minLength": 8,
          "type": "string"
        },
        "status": {
          "enum": [
            "consumer_fixture_only",
            "fails_as_expected",
            "not_applicable",
            "succeeds_invalid",
            "succeeds_valid",
            "succeeds_with_representation_loss"
          ]
        }
      },
      "required": [
        "detail",
        "status"
      ],
      "type": "object"
    },
    "obligation": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/assignment"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
          "x-canonical-order": "ascending lane then fixture_id"
        }
      },
      "required": [
        "assignments"
      ],
      "type": "object"
    },
    "selection_code": {
      "pattern": "^(reason|strategy)(?:\\.[a-z][a-z0-9_]*)+$",
      "type": "string"
    },
    "stable_id": {
      "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)+$",
      "type": "string"
    },
    "support_gate_outcome": {
      "additionalProperties": false,
      "properties": {
        "inventory_gate": {
          "enum": [
            "fail_closed",
            "not_applicable",
            "pass",
            "verification_pending"
          ]
        },
        "meshing_gate": {
          "enum": [
            "fail",
            "not_applicable",
            "pass",
            "verification_pending"
          ]
        },
        "selection_codes": {
          "items": {
            "$ref": "#/$defs/selection_code"
          },
          "type": "array",
          "uniqueItems": true,
          "x-canonical-order": "ascending selection code"
        },
        "support_states": {
          "items": {
            "enum": [
              "SupportedAnalyticTemplate",
              "SupportedStructuredPatch",
              "SupportedPlanarCutGraph",
              "DeferredResidualSurface",
              "UnsupportedTopology",
              "InvalidImportedGeometry",
              "AmbiguousRecognition",
              "UnrecognisedExactGeometry"
            ]
          },
          "type": "array",
          "uniqueItems": true,
          "x-canonical-order": "ascending support state"
        }
      },
      "required": [
        "inventory_gate",
        "meshing_gate",
        "selection_codes",
        "support_states"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.weftocct.example/v1/nonprocedural-obligation-authoring-map-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict complement to the modular procedural recipe map. Each remaining obligation is assigned to one or more legacy, OCCT-procedural, derived, native-fault, audited-external, or M1 consumer-oracle fixtures. Assignments are feasible authoring plans and explicit limitations, not coverage or consumer-verification claims.",
